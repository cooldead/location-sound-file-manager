# Arch Linux / CachyOS / Manjaro package. Build with linux/build_packages.sh,
# or by hand: makepkg -si (downloads the Linux release tarball).
pkgname=location-sound-file-manager
pkgver=1.4.0
pkgrel=1
pkgdesc="Offload recorder cards, make sound reports, and browse, play, rename and organise production sound (BWF/iXML)"
arch=('any')
url="https://github.com/cooldead/location-sound-file-manager"
license=('MIT')
depends=('python' 'pyside6' 'qt6-multimedia' 'qt6-multimedia-ffmpeg' 'python-numpy')
optdepends=('udisks2: eject cards from the app'
            'util-linux: find inserted cards (lsblk)')
source=("Location-Sound-File-Manager-$pkgver-linux.tar.gz::$url/releases/download/v$pkgver-linux/Location-Sound-File-Manager-$pkgver-linux.tar.gz")
sha256sums=('SKIP')

package() {
    cd "location-sound-file-manager-$pkgver"
    install -d "$pkgdir/usr/lib/$pkgname"
    cp -r sound_file_manager "$pkgdir/usr/lib/$pkgname/"
    find "$pkgdir/usr/lib/$pkgname" -name __pycache__ -prune -exec rm -rf {} +
    python -m compileall -q -d "/usr/lib/$pkgname" "$pkgdir/usr/lib/$pkgname"

    install -d "$pkgdir/usr/bin"
    printf '%s\n' '#!/bin/sh' \
        "PYTHONPATH=\"/usr/lib/$pkgname\${PYTHONPATH:+:\$PYTHONPATH}\" exec python3 -m sound_file_manager \"\$@\"" \
        > "$pkgdir/usr/bin/$pkgname"
    chmod 755 "$pkgdir/usr/bin/$pkgname"

    sed -e "s|^Exec=.*|Exec=$pkgname|" -e "s|^Icon=.*|Icon=$pkgname|" "$pkgname.desktop" |
        install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$pkgname.desktop"
    install -Dm644 sound_file_manager/assets/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/$pkgname.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
